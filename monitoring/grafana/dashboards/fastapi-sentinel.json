{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Process Uptime (s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "fastapi_uptime_seconds", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" } }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Alerts",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "fastapi_active_alerts_total", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate %",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "fastapi_error_rate_percent", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 10 },
          { "color": "red", "value": 20 }
        ] } }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU %",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "fastapi_system_cpu_percent", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(fastapi_requests_total[1m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency (p95)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(fastapi_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host Resources",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "fastapi_system_cpu_percent", "legendFormat": "CPU", "refId": "A" },
        { "expr": "fastapi_system_memory_percent", "legendFormat": "RAM", "refId": "B" },
        { "expr": "fastapi_system_disk_percent", "legendFormat": "Disk", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fastapi", "sentinel", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "FastAPI API Sentinel",
  "uid": "fastapi-sentinel",
  "version": 1
}
