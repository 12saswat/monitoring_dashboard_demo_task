# Server Configuration
APP_NAME="FastAPI API Sentinel"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="super-secret-api-key-change-in-production"
AUTH_DEMO_TOKEN="sentinel-secure-token-2026"

# Database Configuration
DATABASE_URL="sqlite:///./monitoring.db"

# Alerting Thresholds
ALERT_LATENCY_THRESHOLD_SEC=3.0
ALERT_ERROR_RATE_PERCENT=20.0
ALERT_WINDOW_SIZE=20
ALERT_CPU_PERCENT=90.0
ALERT_MEMORY_PERCENT=90.0

# Notification Channels (leave empty to simulate; set values for live dispatch)
SLACK_WEBHOOK_URL=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=587
EMAIL_SENDER="alerts@fastapi-monitor.local"
EMAIL_RECIPIENT="admin@example.com"
EMAIL_PASSWORD=""
# Optional: POST JSON to a pager/Twilio Function/n8n webhook for CRITICAL alerts
CALL_WEBHOOK_URL=""
